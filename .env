# Server Configuration
NODE_ENV=development
PORT=8080

# Database Configuration
# Local MongoDB (make sure MongoDB is running locally)
MONGODB_URI=mongodb+srv://wellio:wellio@wellio-cluster.byutg5x.mongodb.net/wellio?retryWrites=true&w=majority
MONGODB_URI_DEV=mongodb+srv://welliodev:welliodev@wellio-dev-cluster.oe1cbeg.mongodb.net/wellio?retryWrites=true&w=majority

# Alternative: MongoDB Atlas (uncomment and replace with your connection string)
# MONGODB_URI_DEV=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wellio?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wellio?retryWrites=true&w=majority

# JWT Configuration
# 1F Authentication Token (for OTP verification) - 60 seconds
JWT_1F_SECRET=wellio-1f-auth-secret-key-for-otp-verification-super-secure-random-string
JWT_1F_EXPIRY=60s

# Access Token - 1 hour (configurable)
JWT_ACCESS_SECRET=wellio-access-token-secret-key-very-long-and-secure-random-string
JWT_ACCESS_EXPIRY=1h

# Refresh Token - 6 hours (configurable)
JWT_REFRESH_SECRET=wellio-refresh-token-secret-key-extremely-secure-random-string
JWT_REFRESH_EXPIRY=180d

# Email Configuration (SMTP) - Configure with your email service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=wellio2025@gmail.com
SMTP_PASS=oztq tsdk sevz hjhb
SMTP_FROM=noreply@wellio.com

# Google OAuth Configuration - Configure with your Google OAuth credentials
# GOOGLE_CLIENT_ID is required for ID token verification (current implementation)
GOOGLE_CLIENT_ID=408284231925-u4cbgln1abogujegp5i6jsstt789plf4.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET is only needed for server-to-server OAuth flows (not currently used)
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ImgBB API Configuration - For image upload service
# Get your API key from: https://api.imgbb.com/
IMGBB_API_KEY=cb0db289e1b1d9787eccaef1b96b7c0b

# Security Configuration
BCRYPT_SALT_ROUNDS=12

# Rate Limiting Configuration
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW_MS=300000
SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=3
SIGNUP_RATE_LIMIT_WINDOW_MS=3600000

